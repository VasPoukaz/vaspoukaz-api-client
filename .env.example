# Token of the merchant's connection (vp_test_… for the sandbox, vp_live_… for real vouchers).
VASPOUKAZ_TOKEN=vp_test_replace_me

# Signing secret of your integration (whsec_…). Without it webhooks are refused.
VASPOUKAZ_WEBHOOK_SECRET=

# Leave as it is unless you were given another address.
VASPOUKAZ_BASE_URL=https://vaspoukaz.cz/api/v1

PORT=4010
