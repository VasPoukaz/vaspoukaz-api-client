{
  "name": "vaspoukaz-api-client",
  "version": "1.0.0",
  "private": true,
  "description": "Example TypeScript client for the VášPoukaz API, with a quickstart script and a demo booking system.",
  "homepage": "https://vaspoukaz.cz/firmy/api",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "quickstart": "node --env-file-if-exists=.env examples/quickstart.ts",
    "demo": "node --env-file-if-exists=.env examples/booking-demo/server.ts",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.0"
  }
}
